#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# herdr add-on: runs the headless herdr server
# Panes inherit this environment, including SUPERVISOR_TOKEN.
# ==============================================================================
export PATH="${HOME}/.local/bin:${PATH}"
export SHELL=/bin/bash
export TERM=xterm-256color
if [[ -r /run/herdr/env.sh ]]; then
    # shellcheck disable=SC1091
    source /run/herdr/env.sh
fi

bashio::log.info 'Starting herdr server...'
cd /config || bashio::exit.nok 'Could not change into /config'
exec herdr server
