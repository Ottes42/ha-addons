#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# herdr add-on: prepares the persistent home, SSH access and Claude Code
# ==============================================================================
readonly SSH_HOST_KEY=/data/ssh/ssh_host_ed25519_key

mkdir -p "${HOME}/.ssh" /data/ssh
chmod 700 "${HOME}" "${HOME}/.ssh" /data/ssh

# Host key lives in /data, so clients don't see a new key after every update
if ! bashio::fs.file_exists "${SSH_HOST_KEY}"; then
    bashio::log.info 'Generating SSH host key...'
    ssh-keygen -q -t ed25519 -N '' -f "${SSH_HOST_KEY}" \
        || bashio::exit.nok 'Failed generating SSH host key'
fi

# authorized_keys always reflects the add-on options
: > "${HOME}/.ssh/authorized_keys"
if bashio::config.has_value 'authorized_keys'; then
    bashio::config 'authorized_keys' > "${HOME}/.ssh/authorized_keys"
else
    bashio::log.warning 'No authorized_keys configured, SSH login is not possible'
fi
chmod 600 "${HOME}/.ssh/authorized_keys"

# Convenience links like in the SSH and VS Code add-ons
for dir in config share addons; do
    ln -sfn "/${dir}" "${HOME}/${dir}"
done
ln -sfn /config /homeassistant

git config --global --replace-all safe.directory '*'

# User-defined environment (secrets.yaml, /addon_config/env, options)
herdr-env /run/herdr/env.sh \
    || bashio::log.warning 'Failed loading custom environment variables'

# Claude Code installs into the persistent home and updates itself there
if [[ ! -x "${HOME}/.local/bin/claude" ]]; then
    bashio::log.info 'Installing Claude Code...'
    curl -fsSL https://claude.ai/install.sh | bash \
        || bashio::log.warning 'Claude Code installation failed, retrying on next start'
fi

# Bundled skills are managed by the add-on and refreshed on every start
mkdir -p "${HOME}/.claude/skills"
for skill in /usr/share/herdr/skills/*/; do
    name="$(basename "${skill}")"
    rm -rf "${HOME}/.claude/skills/${name}"
    cp -r "${skill}" "${HOME}/.claude/skills/${name}"
done

# Instructions and permissions for coding agents (managed block / rules only)
herdr-agents || bashio::log.warning 'Failed setting up agent instructions and permissions'

# MCP bridge to the ESPHome Device Builder, registered once for Claude Code
if [[ -x "${HOME}/.local/bin/claude" ]] \
    && ! "${HOME}/.local/bin/claude" mcp get esphome >/dev/null 2>&1; then
    "${HOME}/.local/bin/claude" mcp add --scope user esphome -- /usr/local/bin/esphome-mcp >/dev/null \
        || bashio::log.warning 'Failed registering the esphome MCP server'
fi
