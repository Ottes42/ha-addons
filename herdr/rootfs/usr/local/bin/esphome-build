#!/usr/bin/env python3
"""Compile and install ESPHome firmware through the Device Builder.

  esphome-build compile esp32c3-btproxy-buro.yaml
  esphome-build upload  esp32c3-btproxy-buro.yaml [PORT]   (default port: OTA)
  esphome-build install esp32c3-btproxy-buro.yaml [PORT]   compile, then upload

Uses the builder's own toolchain and stored credentials over its WebSocket
spawn protocol, so it also works where the MCP endpoint (esphome-mcp) is
missing. Needs the same add-on setup as esphome-mcp. Exit code 1 on failure.
"""
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "herdr"))
import hatools  # noqa: E402
from websockets.sync.client import connect  # noqa: E402

ANSI = re.compile(r"(?:\x1b|\\033)\[[0-9;]*m")


def run(base, action, configuration, port):
    message = {"type": "spawn", "configuration": configuration}
    if action == "upload":
        message["port"] = port
    url = base.replace("http", "ws", 1) + f"/{action}"
    with connect(url, max_size=None, open_timeout=30, ping_interval=None) as ws:
        ws.send(json.dumps(message))
        while True:
            frame = json.loads(ws.recv(timeout=1800))
            if frame.get("event") == "line":
                sys.stdout.write(ANSI.sub("", frame.get("data", "")))
                sys.stdout.flush()
            elif frame.get("event") == "exit":
                return frame.get("code", 1)


def main():
    args = sys.argv[1:]
    if len(args) < 2 or args[0] not in ("compile", "upload", "install"):
        print(__doc__.strip())
        sys.exit(0 if args and args[0] in ("-h", "--help") else 2)
    action, configuration = args[0], args[1].rsplit("/", 1)[-1]
    port = args[2] if len(args) > 2 else "OTA"
    try:
        base = hatools.esphome_url()
    except RuntimeError as err:
        hatools.die(str(err))
    steps = ["compile", "upload"] if action == "install" else [action]
    for step in steps:
        print(f"== {step} {configuration}", flush=True)
        code = run(base, step, configuration, port)
        if code != 0:
            hatools.die(f"{step} of {configuration} failed (exit {code})")
    print(f"== {action} {configuration} done")


if __name__ == "__main__":
    main()
