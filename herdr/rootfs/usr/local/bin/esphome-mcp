#!/usr/bin/env python3
"""stdio MCP bridge to the ESPHome Device Builder (its /api/mcp endpoint).

Add-ons cannot open ingress sessions, so the bridge uses the Device Builder's
own port. In the ESPHome add-on enable `leave_front_door_open` and map port
6052 under Network; the bridge then finds the port by itself. Every JSON-RPC
message from stdin is forwarded as one POST, the reply goes to stdout.

  esphome-mcp           run as MCP server (Claude Code starts it)
  esphome-mcp --check   test the connection and list the tools

ESPHOME_URL overrides the address (e.g. http://192.168.1.2:6052),
ESPHOME_ADDON the add-on slug (default: first running one of
5c53de3b_esphome, 5c53de3b_esphome-beta, 5c53de3b_esphome-dev).
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "herdr"))
import hatools  # noqa: E402


class Bridge:
    def __init__(self):
        self.base = None

    def post(self, payload):
        if self.base is None:
            self.base = hatools.esphome_url()
        try:
            status, _, raw = hatools.request("POST", f"{self.base}/api/mcp", payload, timeout=120, auth=False)
        except SystemExit as err:
            raise RuntimeError(f"Device Builder at {self.base} not reachable; {hatools.ESPHOME_SETUP_HINT}") from err
        if status == 202:
            return None
        if status == 405:
            raise RuntimeError("this Device Builder has no MCP endpoint yet (added in ESPHome 2026.10); use esphome-build")
        if status != 200:
            raise RuntimeError(f"Device Builder answered {status}: {raw[:300].decode(errors='replace')}")
        return raw.decode()


def error_reply(message, error):
    if not isinstance(message, dict) or message.get("id") is None:
        return None
    return json.dumps({"jsonrpc": "2.0", "id": message["id"], "error": {"code": -32603, "message": str(error)}})


def check(bridge):
    init = {
        "jsonrpc": "2.0", "id": 1, "method": "initialize",
        "params": {"protocolVersion": "2025-11-25", "capabilities": {},
                   "clientInfo": {"name": "esphome-mcp", "version": "1"}},
    }
    server = json.loads(bridge.post(init))["result"]["serverInfo"]
    tools = json.loads(bridge.post({"jsonrpc": "2.0", "id": 2, "method": "tools/list"}))["result"]["tools"]
    print(f"{server['name']} {server['version']} at {bridge.base}")
    print("tools: " + ", ".join(t["name"] for t in tools))


def main():
    bridge = Bridge()
    if len(sys.argv) > 1:
        if sys.argv[1] != "--check":
            print(__doc__.strip())
            return
        try:
            check(bridge)
        except RuntimeError as err:
            hatools.die(str(err))
        return
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            message = json.loads(line)
        except ValueError:
            continue
        try:
            reply = bridge.post(message)
        except (RuntimeError, OSError) as err:
            reply = error_reply(message, err)
        if reply:
            sys.stdout.write(reply.strip() + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
