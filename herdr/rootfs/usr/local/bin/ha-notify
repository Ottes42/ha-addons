#!/usr/bin/env python3
"""Notify the user in Home Assistant: ha-notify "message" ["title"]

Uses HA_NOTIFY_SERVICE (e.g. notify.mobile_app_phone) when set, otherwise a
persistent notification (the bell in the sidebar).
"""
import os
import sys

sys.path.insert(0, "/usr/local/lib/herdr")
import hatools  # noqa: E402

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    print(__doc__.strip())
    sys.exit(0 if len(sys.argv) > 1 else 2)
data = {"message": sys.argv[1], "title": sys.argv[2] if len(sys.argv) > 2 else "herdr"}
service = os.environ.get("HA_NOTIFY_SERVICE", "persistent_notification.create")
domain, _, name = service.partition(".")
status, result = hatools.core("POST", f"services/{domain}/{name}", data)
if status >= 400:
    hatools.die(f"{service} failed: {result}")
