#!/usr/bin/env python3
"""Show entity states compactly.

  ha-state                    all entities
  ha-state light.             one domain
  ha-state sensor.buro_*      shell-style pattern on the entity id
  ha-state climate.bad -a     one entity with all attributes
"""
import fnmatch
import sys

sys.path.insert(0, "/usr/local/lib/herdr")
import hatools  # noqa: E402

args = [a for a in sys.argv[1:] if a not in ("-a", "--attributes")]
show_attributes = len(args) != len(sys.argv) - 1
if args and args[0] in ("-h", "--help"):
    print(__doc__.strip())
    sys.exit(0)
pattern = args[0] if args else "*"
if pattern.endswith("."):
    pattern += "*"

if "*" not in pattern and "?" not in pattern:
    status, state = hatools.core("GET", f"states/{pattern}")
    if status == 404:
        hatools.die(f"{pattern} not found")
    states = [state]
else:
    _, states = hatools.core("GET", "states")
    states = [s for s in states if fnmatch.fnmatch(s["entity_id"], pattern)]

for s in sorted(states, key=lambda s: s["entity_id"]):
    attrs = s.get("attributes", {})
    if show_attributes:
        hatools.dump(s)
        continue
    value = f"{s['state']} {attrs.get('unit_of_measurement', '')}".strip()
    name = attrs.get("friendly_name", "")
    print(f"{s['entity_id']}\t{value}\t{name}")
