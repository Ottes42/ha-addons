#!/usr/bin/env python3
"""Send one command to the Home Assistant WebSocket API and print its result.

  ha-ws config/entity_registry/list
  ha-ws config/entity_registry/update '{"entity_id": "light.x", "area_id": "buro"}'
  ha-ws lovelace/config '{"url_path": "ottes-home"}'
  echo '{"url_path": "x", "config": {...}}' | ha-ws lovelace/config/save -
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "herdr"))
import hatools  # noqa: E402
from websockets.sync.client import connect  # noqa: E402

args = sys.argv[1:]
if not args or args[0] in ("-h", "--help"):
    print(__doc__.strip())
    sys.exit(0 if args else 2)
command = {"id": 1, "type": args[0], **(hatools.read_json_arg(args[1]) if len(args) > 1 else {})}

with connect("ws://supervisor/core/websocket", max_size=None, open_timeout=30) as ws:
    if json.loads(ws.recv()).get("type") != "auth_required":
        hatools.die("unexpected greeting from Home Assistant")
    ws.send(json.dumps({"type": "auth", "access_token": hatools.token()}))
    if json.loads(ws.recv()).get("type") != "auth_ok":
        hatools.die("authentication failed")
    ws.send(json.dumps(command))
    while True:
        message = json.loads(ws.recv(timeout=300))
        if message.get("id") == 1 and message.get("type") == "result":
            break

if message.get("success"):
    hatools.dump(message.get("result"))
else:
    hatools.die(json.dumps(message.get("error"), ensure_ascii=False))
