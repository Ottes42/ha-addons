#!/usr/bin/env python3
"""Set up instructions and permissions for coding agents in the persistent home.

- Writes the add-on's notes plus the option `agent_instructions` as a managed
  block into ~/.claude/CLAUDE.md and ~/.codex/AGENTS.md. Text outside the
  block is left alone.
- Merges the rules of the option `permission_mode` (read, build, admin) plus
  the options `claude_allow` and `claude_deny` into ~/.claude/settings.json.
  The notes get a matching paragraph, so "ask first" and the rules agree. Rules the add-on added earlier
  and no longer wants are removed, rules added by hand stay.

HERDR_AGENTS_HOME overrides the home directory (for tests).
"""
import json
import os
import sys
from pathlib import Path

OPTIONS = Path(os.environ.get("HERDR_OPTIONS", "/data/options.json"))
NOTES = Path(__file__).resolve().parent.parent.parent / "share" / "herdr" / "AGENTS.md"
HOME = Path(os.environ.get("HERDR_AGENTS_HOME", Path.home()))
STATE = HOME / ".config" / "herdr-addon" / "managed-permissions.json"
BEGIN = "<!-- herdr add-on: begin (managed, edits are overwritten) -->"
END = "<!-- herdr add-on: end -->"

# Read-only commands that should not need a confirmation
DEFAULT_ALLOW = [
    "Bash(ha-state)",
    "Bash(ha-state *)",
    "Bash(ha-check)",
    "Bash(ha-api states*)",
    "Bash(ha-api -s addons*)",
    "Bash(ha addons)",
    "Bash(ha addons info *)",
    "Bash(ha addons logs *)",
    "Bash(ha core info)",
    "Bash(ha core check)",
    "Bash(esphome-mcp --check)",
    "Bash(esphome-build compile *)",
    "Bash(esphome-logs *)",
    "Bash(esphome-crash *)",
]

# permission_mode: each level adds to the one before
MODE_ALLOW = {
    "read": [],
    "build": [
        "Bash(ha-api POST services/*/reload*)",
        "Bash(ha-ws *)",
        "Bash(ha-notify *)",
        "Bash(esphome-build *)",
    ],
    "admin": [
        "Bash(ha core restart)",
        "Bash(ha core stop)",
        "Bash(ha core start)",
        "Bash(ha addons restart *)",
        "Bash(ha addons start *)",
        "Bash(ha addons stop *)",
        "Bash(ha backups new*)",
        "Bash(ha-api POST services/*)",
    ],
}
MODES = list(MODE_ALLOW)

# Never, in any mode: restarting or stopping herdr ends every session
ALWAYS_DENY = [
    "Bash(ha addons restart *herdr*)",
    "Bash(ha addons stop *herdr*)",
    "Bash(ha addons rebuild *herdr*)",
    "Bash(ha addons update *herdr*)",
]

MODE_NOTES = {
    "read": """\
### Berechtigungsmodus: read

Ohne Rückfrage erlaubt sind nur lesende Werkzeuge. Alles andere fragt Claude Code
nach, die Regeln oben gelten unverändert.
""",
    "build": """\
### Berechtigungsmodus: build

Ohne Rückfrage erlaubt: Domains neu laden, `ha-ws`, `ha-notify` und ESPHome-Geräte
kompilieren und flashen. Flashen musst du deshalb nicht mehr ankündigen. Vor einem
Neustart von Core oder anderen Add-ons weiter nachfragen.
""",
    "admin": """\
### Berechtigungsmodus: admin

Neustarts von Home Assistant Core und anderen Add-ons, Backups und beliebige
Dienstaufrufe sind freigegeben, ebenso alles aus `build`. Vor einem Core-Neustart
`ha-check` ausführen, nur neu starten, wenn ein Reload nicht reicht, und danach mit
`ha-notify` sagen, warum. Das herdr-Add-on selbst bleibt tabu.
""",
}


def log(message):
    print(f"[herdr-agents] {message}", file=sys.stderr)


def write_block(path, content):
    block = f"{BEGIN}\n{content.strip()}\n{END}\n"
    text = path.read_text() if path.exists() else ""
    if BEGIN in text and END in text:
        head, _, rest = text.partition(BEGIN)
        _, _, tail = rest.partition(END)
        text = head + block + tail.lstrip("\n")
    else:
        text = block + ("\n" + text if text else "")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)


def merge_permissions(allow, deny):
    settings_file = HOME / ".claude" / "settings.json"
    try:
        settings = json.loads(settings_file.read_text()) if settings_file.exists() else {}
    except ValueError:
        log(f"{settings_file} is not valid JSON, permissions not changed")
        return
    try:
        previous = json.loads(STATE.read_text())
    except (OSError, ValueError):
        previous = {}

    permissions = settings.setdefault("permissions", {})
    for key, wanted in (("allow", allow), ("deny", deny)):
        managed_before = previous.get(key, [])
        rules = [r for r in permissions.get(key, []) if r not in managed_before or r in wanted]
        rules += [r for r in wanted if r not in rules]
        if rules:
            permissions[key] = rules
        else:
            permissions.pop(key, None)
    if not permissions:
        settings.pop("permissions")

    settings_file.parent.mkdir(parents=True, exist_ok=True)
    settings_file.write_text(json.dumps(settings, indent=2, ensure_ascii=False) + "\n")
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps({"allow": allow, "deny": deny}))


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return
    options = json.loads(OPTIONS.read_text()) if OPTIONS.exists() else {}
    notes = NOTES.read_text()
    mode = options.get("permission_mode") or "read"
    if mode not in MODE_ALLOW:
        log(f"unknown permission_mode {mode!r}, using read")
        mode = "read"
    notes += "\n" + MODE_NOTES[mode]
    custom = (options.get("agent_instructions") or "").strip()
    if custom:
        notes += f"\n### Anweisungen aus der Add-on-Konfiguration\n\n{custom}\n"
    for path in (HOME / ".claude" / "CLAUDE.md", HOME / ".codex" / "AGENTS.md"):
        write_block(path, notes)

    allow = list(DEFAULT_ALLOW)
    for level in MODES[: MODES.index(mode) + 1]:
        allow += MODE_ALLOW[level]
    allow += [r for r in options.get("claude_allow") or [] if r not in allow]
    deny = ALWAYS_DENY + [r for r in options.get("claude_deny") or [] if r not in ALWAYS_DENY]
    merge_permissions(allow, deny)
    log(f"instructions written, mode {mode}, {len(allow)} allow and {len(deny)} deny rules")


if __name__ == "__main__":
    main()
